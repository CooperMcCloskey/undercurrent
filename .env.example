# Copy to .env (gitignored). Everything here is optional.

# Jev runs on the server/pipeline only. Never prefix this with VITE_.
JEV_API_KEY=
JEV_MODEL=jev-latest
# Optional explicit API export directory; otherwise emerging-export is preferred when ready.
UC_EXPORT_DIR=

# Embedding model (Hugging Face id). Multilingual because GDELT is.
UC_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Google Cloud project that BigQuery bills for the GDELT pull (ingest/gdelt_bq.py).
# Log in first with `gcloud auth application-default login`; see pipeline/undercurrent/ingest/GDELT.md.
GOOGLE_CLOUD_PROJECT=

# Wikimedia asks API clients for a descriptive User-Agent with a way to contact you.
WIKIMEDIA_USER_AGENT=undercurrent/0.1 (https://github.com/CooperMcCloskey/undercurrent)

# Reddit (stretch goal). Needs an approved "script" app: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=undercurrent/0.1 (hackathon project)
